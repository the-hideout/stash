{
  "name": "stash-discord-bot",
  "version": "0.0.0",
  "private": true,
  "description": "Tarkov.dev's Escape from Tarkov Discord bot",
  "main": "index.mjs",
  "engines": {
    "node": "22.*"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/the-hideout/stash.git"
  },
  "license": "GNU General Public License v3.0",
  "homepage": "https://github.com/the-hideout/stash",
  "scripts": {
    "start": "node index.mjs",
    "dev": "cross-env NODE_ENV=development nodemon --ignore cache/ -r dotenv/config index.mjs",
    "dev-commands": "cross-env NODE_ENV=ci node deploy-commands-dev.mjs",
    "deploy": "railway up --service stash"
  },
  "type": "module",
  "dependencies": {
    "@discordjs/rest": "^2.6.3",
    "ascii-table": "^0.0.9",
    "cron": "^3.1.7",
    "cross-env": "^10.1.0",
    "discord-api-types": "^0.38.47",
    "discord.js": "^14.27.0",
    "dotenv": "^17.4.2",
    "i18next": "^26.3.1",
    "jsonpath-plus": "^10.4.0",
    "luxon": "^3.7.2"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
